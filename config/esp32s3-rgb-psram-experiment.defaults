# Experimental phase A only: append after sdkconfig.defaults and esp32s3-rgb.defaults.
# Intended for a confirmed ESP32-S3-WROOM-1-N16R8 module with octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=n
